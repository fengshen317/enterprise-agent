# 复制到仓库根目录的 .env。必填，只填主机名，例如 agent.example.com。
EA_DEPLOY_DOMAIN=

# 必填，填入生成的随机密码，例如 openssl rand -hex 32 的输出。
EA_DATABASE_PASSWORD=
EA_DATABASE_NAME=enterprise_agent
EA_DATABASE_USER=enterprise_agent
# 可管理部署级 API 与知识库模型的工作台账号，应与首次初始化账号一致。
EA_SYSTEM_ADMIN_USERNAME=admin

# 构建可选。填写可信的 PyPI 镜像 simple 索引，依赖版本和哈希仍取自 uv.lock。
# EA_PYPI_INDEX_URL=https://pypi.org/simple

# 优先在工作台「API 配置」填写语言模型。环境变量可作为已有部署的默认值。
# EA_DEEPSEEK_API_KEY=

# 内置 RAGFlow。为其内部服务单独生成随机密码（openssl rand -hex 32）。
EA_RAGFLOW_SERVICE_PASSWORD=
# 内置部署会自动签发 Key。接入已有 RAGFlow 时填写该实例的 Key。
EA_RAGFLOW_API_KEY=
# 仅在沿用已有 RAGFlow 超级管理员时填写原密码。
# EA_RAGFLOW_ADMIN_PASSWORD=
# EA_RAGFLOW_IMAGE=infiniflow/ragflow:v1.0.0
# EA_RAGFLOW_UI_PORT=9388
# EA_RAGFLOW_REGISTER_ENABLED=0
# EA_RAGFLOW_BASE_URL=http://ragflow:80

# 可选服务。其余后端参数见 backend/.env.example。
EA_TAVILY_API_KEY=
EA_CHANNEL_TOKEN_KEY=
EA_CONNECTOR_CREDENTIAL_KEY=
