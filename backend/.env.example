EA_ENVIRONMENT=development
# 使用已有 PostgreSQL 服务；密码填原文，不需要 URL 编码
EA_DATABASE_HOST=127.0.0.1
EA_DATABASE_PORT=5432
EA_DATABASE_USER=postgres
EA_DATABASE_PASSWORD='YOUR_POSTGRES_PASSWORD'
EA_DATABASE_NAME=enterprise_agent
EA_TEST_DATABASE_NAME=enterprise_agent_test
EA_CORS_ORIGINS=["http://localhost:8686","http://127.0.0.1:8686"]
EA_LOG_LEVEL=INFO
EA_DATABASE_TIMEOUT_SECONDS=3

# DeepSeek 官方 API 密钥，仅在本地填写，不提交真实值
EA_DEEPSEEK_API_KEY=

# 问答模型与生成限制
EA_DEEPSEEK_MODEL=deepseek-flash
EA_MODEL_TIMEOUT_SECONDS=120
# 整轮对话包含规划、子 Agent 和重试等待，区别于单次模型请求超时。
EA_CHAT_RUN_TIMEOUT_SECONDS=1800
EA_MODEL_MAX_TOKENS=4096

# 持久化上下文压缩；原始聊天消息完整保留
EA_CONTEXT_COMPRESSION_ENABLED=true
EA_CONTEXT_COMPRESSION_TRIGGER_RATIO=0.7
EA_CONTEXT_COMPRESSION_RECENT_TURNS=4
EA_CONTEXT_SUMMARY_CHARACTERS=4000
EA_CONTEXT_SUMMARY_BATCH_CHARACTERS=32000

# 本机会话与登录失败窗口；业务密码由账号管理命令交互输入
EA_AUTH_SESSION_HOURS=12
EA_AUTH_COOKIE_SECURE=false
EA_AUTH_LOGIN_MAX_FAILURES=5
EA_AUTH_LOGIN_WINDOW_SECONDS=900

# 原生只读工具；执行身份从当前运行绑定
EA_TOOLS_ENABLED=true
EA_TOOL_TIMEOUT_SECONDS=5
EA_TOOL_MAX_CALLS_PER_RUN=4

# 本地持久化计划执行；单任务默认串行，独立分支可调整为2
EA_TASK_SCHEDULER_ENABLED=true
EA_TASK_RETRY_ATTEMPTS=3
EA_TASK_RETRY_BASE_SECONDS=2
EA_TASK_RETRY_MAX_SECONDS=30
EA_TASK_RETRY_MAX_WAIT_SECONDS=300
EA_TASK_POLL_SECONDS=0.5
EA_TASK_HEARTBEAT_SECONDS=5
EA_TASK_PARALLEL_STEPS=1
EA_TASK_CONCURRENT_RUNS=2

# Cron 定时问答；按计划向固定对话追加真实运行
EA_SCHEDULE_ENABLED=true
EA_SCHEDULE_POLL_SECONDS=5
EA_SCHEDULE_TIMEZONE=Asia/Shanghai

# 知识库；RAGFlow 只由后端访问，API Key 不进入前端或 Git
EA_KNOWLEDGE_ENABLED=true
EA_RAGFLOW_BASE_URL=http://localhost
EA_RAGFLOW_API_KEY=
EA_RAGFLOW_TIMEOUT_SECONDS=15
EA_RAGFLOW_PARSER_ID=general
EA_RAGFLOW_PARSE_TYPE=1
EA_RAGFLOW_EMBEDDING_MODEL=
EA_RAGFLOW_LANGUAGE=
EA_KNOWLEDGE_TOP_K=5
EA_KNOWLEDGE_TEST_TOP_K=20
EA_KNOWLEDGE_SIMILARITY_THRESHOLD=0.2
EA_KNOWLEDGE_MAX_CONTEXT_CHARACTERS=8000
EA_KNOWLEDGE_MAX_CALLS_PER_RUN=3
EA_KNOWLEDGE_MAX_FILE_BYTES=20000000

# Agent 工作台：能力装配、技能预算与写操作审批
EA_AGENT_MAX_TOOLS=20
EA_AGENT_INSTRUCTIONS_CHARACTERS=8000
EA_SKILL_CONTEXT_CHARACTERS=12000
EA_SKILL_ALWAYS_ON_MAX=3
EA_SKILL_LOAD_MAX_CHARACTERS=6000
EA_SKILL_LOAD_MAX_CALLS=3
EA_APPROVAL_TIMEOUT_SECONDS=300
EA_TOOL_OUTPUT_CHARACTERS=8000

# 联网搜索：Tavily API（https://tavily.com 注册获取）
EA_TAVILY_API_KEY=

# 微信 iLink 渠道。未配置密钥时不启用绑定和轮询。
# 生成密钥：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EA_CHANNEL_ENABLED=true
EA_CHANNEL_TOKEN_KEY=
EA_CHANNEL_REPLY_WINDOW_HOURS=24
# 窗口剩余不足这么多小时时提醒一次；0 表示不提醒。
EA_CHANNEL_WINDOW_REMINDER_HOURS=2
EA_CHANNEL_PROGRESS_AFTER_SECONDS=10
EA_CHANNEL_PROGRESS_INTERVAL_SECONDS=20
EA_CHANNEL_REPLY_PREVIEW_CHARACTERS=500
# 微信里「完整回答」链接的网页地址。
EA_PUBLIC_APP_BASE_URL=http://127.0.0.1:8686
EA_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
# 前三段必须是 openclaw-weixin 插件版本，斜杠后是本系统版本。
EA_ILINK_CHANNEL_VERSION=3.0.0/enterprise-agent-0.1.0
EA_ILINK_BOT_AGENT=EnterpriseAgent/0.1.0
EA_ILINK_SESSION_PAUSE_SECONDS=3600
EA_ILINK_LONG_POLL_SECONDS=35
EA_ILINK_MESSAGE_CHUNK_CHARACTERS=1800
EA_WEB_SEARCH_TIMEOUT_SECONDS=10
EA_WEB_SEARCH_MAX_RESULTS=5
